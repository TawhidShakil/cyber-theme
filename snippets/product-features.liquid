{% assign labels = product.metafields.custom.feature_labels.value %}
{% assign values = product.metafields.custom.feature_values.value %}
{% assign icons  = product.metafields.custom.feature_icons %}

{% if labels and values %}
  <div class="mt-8 grid grid-cols-3 gap-4">

    {% for label in labels %}
      {% assign i = forloop.index0 %}

      {% if values[i] %}
        <div class="flex items-center gap-4 rounded-xl bg-gray-100 px-6 py-4 text-[14px]">

          {% if icons and icons.value.size > i %}
            {% assign icon = icons.value[i] %}

            {% if icon and icon.preview_image %}
              {{ icon.preview_image
                | image_url: width: 48
                | image_tag: class: "w-8 h-8 object-contain shrink-0"
              }}
            {% endif %}
          {% endif %}

          <div class="flex flex-col leading-tight">
            <span class="text-gray-400">{{ label }}</span>
            <span class="font-semibold text-gray-900">{{ values[i] }}</span>
          </div>

        </div>
      {% endif %}

    {% endfor %}

  </div>
{% endif %}
