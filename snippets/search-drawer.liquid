<!-- DRAWER SEARCH -->
<form
  action="{{ routes.search_url }}"
  method="get"
  role="search"
  class="relative mb-4"
>
  <!-- Search Icon Button -->
  <button
    type="submit"
    class="absolute inset-y-0 left-3 flex items-center text-gray-400 hover:text-gray-600"
    aria-label="Search"
  >
    <svg
      class="w-5 h-5"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
      />
    </svg>
  </button>

  <!-- Input -->
  <input
    type="search"
    name="q"
    placeholder="Search products"
    value="{{ search.terms | escape }}"
    class="
      w-full
      h-11
      bg-gray-50
      rounded-lg
      pl-10 pr-4
      text-sm
      placeholder-gray-400
      focus:ring-1 focus:ring-gray-200
      focus:bg-white
    "
  />
</form>
