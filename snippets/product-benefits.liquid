<div class="grid grid-cols-3 gap-x-14 mt-8">

  <!-- Free Delivery -->
  <div class="flex items-center gap-5 min-w-0">
    <div class="flex items-center justify-center w-[56px] h-[56px] rounded-[11px] bg-[#F6F6F6] shrink-0">
      {% render 'icons', name: 'truck', class: 'w-7 h-7 text-gray-700' %}
    </div>

    <div class="flex flex-col leading-snug min-w-0">
      <span class="text-[14px] text-[#717171] whitespace-nowrap">
        Free Delivery
      </span>
      <span class="text-[14px] font-semibold text-gray-800 whitespace-nowrap">
        1–2 day
      </span>
    </div>
  </div>

  <!-- In Stock -->
  <div class="flex items-center gap-5 min-w-0">
    <div class="flex items-center justify-center w-[56px] h-[56px] rounded-[11px] bg-[#F6F6F6] shrink-0">
      {% render 'icons', name: 'store', class: 'w-7 h-7 text-gray-700' %}
    </div>

    <div class="flex flex-col leading-snug min-w-0">
      <span class="text-[14px] text-[#717171] whitespace-nowrap">
        In Stock
      </span>
      <span class="text-[14px] font-semibold text-gray-800 whitespace-nowrap">
        Today
      </span>
    </div>
  </div>

  <!-- Guaranteed -->
  <div class="flex items-center gap-5 min-w-0">
    <div class="flex items-center justify-center w-[56px] h-[56px] rounded-[11px] bg-[#F6F6F6] shrink-0">
      {% render 'icons', name: 'verify', class: 'w-7 h-7 text-gray-700' %}
    </div>

    <div class="flex flex-col leading-snug min-w-0">
      <span class="text-[14px] text-[#717171] whitespace-nowrap">
        Guaranteed
      </span>
      <span class="text-[14px] font-semibold text-gray-800 whitespace-nowrap">
        1 year
      </span>
    </div>
  </div>

</div>
