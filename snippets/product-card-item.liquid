<div class="bg-[#F6F6F6]
 rounded-[10px] p-6 flex flex-col items-center relative group h-full transition-all duration-300">
  
<style>
  .font-inter { font-family: 'Inter', sans-serif; }
</style>
  <button 
    type="button"
    class="wishlist-btn absolute top-6 right-6 z-10 transition-colors duration-300" 
    onclick="toggleWishlist(this)"
    aria-label="Toggle wishlist"
  >
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 stroke-gray-400 fill-transparent transition-all pointer-events-none">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
    </svg>
  </button>

  <a href="{{ product.url }}" class="h-[180px] w-full flex items-center justify-center mb-6">
    {% if product.featured_image != blank %}
      <img 
        src="{{ product.featured_image | image_url: width: 400 }}" 
        alt="{{ product.title | escape }}" 
        class="max-h-full max-w-full object-contain mix-blend-multiply transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
      >
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'w-full h-full opacity-20' }}
    {% endif %}
  </a>

  <div class="text-center flex flex-col gap-2 mb-6 flex-grow">
    <h3 class="text-[16px] font-medium text-black leading-tight line-clamp-2 h-[3rem] flex items-center justify-center">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    <p class="text-[24px] font-semibold text-black tracking-tight">
      {{ product.price | money_without_trailing_zeros }}
    </p>
</div>

  <div class="w-full flex justify-center mt-auto">
    <form action="/cart/add" method="post" enctype="multipart/form-data" class="w-full">
      <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
      <button type="submit" class="w-full bg-black text-white py-3 rounded-[8px] text-[14px] font-medium hover:bg-gray-800 transition-colors uppercase tracking-wide">
        Buy Now
      </button>
    </form>
  </div>
</div>