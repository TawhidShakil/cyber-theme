<div class="w-[163px] h-[352px] md:max-w-[268px] md:max-h-[400px] bg-[#F6F6F6] rounded-[10px] p-6 flex flex-col items-center relative group h-full transition-all duration-300">
  
<style>
  .font-inter { font-family: 'Inter', sans-serif; }
</style>

  <button 
    type="button"
    class="wishlist-btn absolute top-6 right-6 z-10 transition-colors duration-300 " 
    onclick="toggleWishlist(this)"
    aria-label="Toggle wishlist"
  >
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 stroke-gray-400 fill-transparent transition-all pointer-events-none">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
    </svg>
  </button>

  <a href="{{ card_product.url }}" class="flex items-center justify-center">
    {% if card_product.featured_image != blank %}
      <img 
        src="{{ card_product.featured_image | image_url: width: 400 }}" 
        alt="{{ card_product.title | escape }}" 
        class="max-h-[104px] max-w-[104px] md:max-h-[160px] md:max-w-[160]  object-contain mix-blend-multiply transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
      >
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'w-full h-full opacity-20' }}
    {% endif %}
  </a>

  <div class="text-center flex flex-col gap-2  flex-grow py-4">
    <h3 class="text-base font-medium text-black leading-tight line-clamp-2 h-[3rem] flex items-center justify-center max-w-[130px]">
      <a href="{{ card_product.url }}">{{ card_product.title }}</a>
    </h3>
    <p class="text-2xl font-semibold text-black tracking-tight">
      {{ card_product.price | money_without_trailing_zeros }}
    </p>
</div>

  <div class="w-auto flex justify-center">
    <form action="/cart/add" method="post" enctype="multipart/form-data" class="w-full">
      <input type="hidden" name="id" value="{{ card_product.variants.first.id }}" />
      <button type="submit" class="w-[110px] h-[28px] md:w-[130px] md:h-[28px] bg-black text-white rounded-[8px] text-sm font-medium hover:bg-gray-800 transition-colors uppercase tracking-wide">
        Buy Now
      </button>
    </form>
  </div>
</div>