    <div class="flex flex-col items-center font-[var(--font-heading)] gap-3 ">
        <p class="text-7xl font-thin text-white">Big Summer <span class="font-bold">Sale</span></p>
        <p class="text-lg font-thin text-[var(--gray-500)]">Commodo fames vitae vitae leo mauris in. Eu consequat.</p>
        <button class="btn btn-primary w-[119px] h-[36px] border border-[var(--gray-100)] rounded-[var(--radius-md)] text-white">
            Shop Now
