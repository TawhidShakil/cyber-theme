{{ 'checkout-step1.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* Inherit shared styles and add Step 2 specific tweaks */
  .shipping-card {
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 25px;
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    background: #fff;
    transition: all 0.2s ease-in-out;
    cursor: pointer;
  }

  .shipping-card.selected { 
    border-color: #000; 
    box-shadow: 0 4px 15px rgba(0,0,0,0.05); 
  }

  .shipping-card .radio-container { margin-right: 20px; }
  
  .shipping-info { flex-grow: 1; display: flex; align-items: center; justify-content: space-between; }
  
  .method-details { display: flex; align-items: center; gap: 15px; }
  .method-name { font-size: 16px; font-weight: 600; color: #1a1a1a; min-width: 80px; }
  .method-desc { font-size: 14px; color: #6b7280; }
  .method-eta { font-size: 14px; font-weight: 500; color: #1a1a1a; }

  /* Date Picker Customization */
  .date-picker-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #9ca3af;
    font-size: 14px;
    cursor: pointer;
  }
  
  .date-input {
    border: none;
    background: transparent;
    font-family: inherit;
    font-size: 14px;
    color: #1a1a1a;
    font-weight: 500;
    cursor: pointer;
    outline: none;
    text-align: right;
  }

  /* Progress Steps Overrides for Step 2 */
  .step-1-done { opacity: 1 !important; color: #000; }
  .step-1-done svg { fill: #000; }
  .step-2-active { opacity: 1 !important; font-weight: 700; }

  @media (max-width: 768px) {
    .shipping-info { flex-direction: column; align-items: flex-start; gap: 10px; }
    .method-eta { align-self: flex-end; }
  }
{%- endstyle -%}

<div class="checkout-container">
  <div class="checkout-steps">
    <div class="step step-1-done">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
      </svg>
      <div class="step-info">
        <span class="step-label">Step 1</span>
        <span class="step-name">Address</span>
      </div>
    </div>
    <div class="step step-2-active">
       <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1" y="3" width="15" height="13"></rect>
        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
        <circle cx="5.5" cy="18.5" r="2.5"></circle>
        <circle cx="18.5" cy="18.5" r="2.5"></circle>
      </svg>
      <div class="step-info">
        <span class="step-label">Step 2</span>
        <span class="step-name">Shipping</span>
      </div>
    </div>
    <div class="step">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="2" y="5" width="20" height="14" rx="2"/>
        <line x1="2" y1="10" x2="22" y2="10"/>
      </svg>
      <div class="step-info">
        <span class="step-label">Step 3</span>
        <span class="step-name">Payment</span>
      </div>
    </div>
  </div>

  <h2 style="font-size: 20px; font-weight: 700; margin-bottom: 25px;">Shipment Method</h2>

  <div class="shipping-list">
    <div class="shipping-card selected" onclick="selectShipping(this)">
      <div class="radio-container">
        <input type="radio" name="shipping_method" value="free" checked>
      </div>
      <div class="shipping-info">
        <div class="method-details">
          <span class="method-name">Free</span>
          <span class="method-desc">Regular shipment</span>
        </div>
        <span class="method-eta">17 Oct, 2023</span>
      </div>
    </div>

    <div class="shipping-card" onclick="selectShipping(this)">
      <div class="radio-container">
        <input type="radio" name="shipping_method" value="priority">
      </div>
      <div class="shipping-info">
        <div class="method-details">
          <span class="method-name">$8.50</span>
          <span class="method-desc">Get your delivery as soon as possible</span>
        </div>
        <span class="method-eta">1 Oct, 2023</span>
      </div>
    </div>

    <div class="shipping-card" onclick="selectShipping(this)">
      <div class="radio-container">
        <input type="radio" name="shipping_method" value="schedule">
      </div>
      <div class="shipping-info">
        <div class="method-details">
          <span class="method-name">Schedule</span>
          <span class="method-desc">Pick a date when you want to get your delivery</span>
        </div>
        <div class="date-picker-wrapper">
          <input type="text" class="date-input" id="deliveryDate" placeholder="Select Date" onfocus="(this.type='date')" onblur="if(!this.value)this.type='text'">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </div>
      </div>
    </div>
  </div>

  <div class="checkout-footer">
    <button type="button" class="btn-back" onclick="history.back()">Back</button>
    <button type="button" class="btn-next" onclick="handleShippingNext()">Next</button>
  </div>
</div>

<script>
  function selectShipping(card) {
    document.querySelectorAll('.shipping-card').forEach(c => c.classList.remove('selected'));
    card.classList.add('selected');
    card.querySelector('input[type="radio"]').checked = true;
    
    // Focus date input if schedule is selected
    const dateInput = card.querySelector('#deliveryDate');
    if(dateInput) {
        dateInput.focus();
    }
  }

  function handleShippingNext() {
    const selectedMethod = document.querySelector('input[name="shipping_method"]:checked').value;
    const scheduleDate = document.getElementById('deliveryDate').value;

    if (selectedMethod === 'schedule' && !scheduleDate) {
      alert("Please select a delivery date");
      return;
    }

    // Save to session storage
    sessionStorage.setItem('selected_shipping', JSON.stringify({
      method: selectedMethod,
      date: scheduleDate || 'standard'
    }));

    // Redirect to Step 3 (Payment)
    window.location.href = '/pages/checkout-step-3';
  }
</script>