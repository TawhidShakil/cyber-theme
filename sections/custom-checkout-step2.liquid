{{ 'custom-checkout.css' | asset_url | stylesheet_tag }}

<div class="custom-checkout-wrapper">
  <!-- Progress Indicator -->
  <div class="checkout-progress">
    <div class="progress-step completed">
      <div class="step-circle">✓</div>
      <span>Address</span>
    </div>
    <div class="progress-step active">
      <div class="step-circle">2</div>
      <span>Shipping</span>
    </div>
    <div class="progress-step">
      <div class="step-circle">3</div>
      <span>Payment</span>
    </div>
  </div>

  <div class="checkout-container">
    <div class="checkout-main">
      <div class="checkout-header">
        <a href="/pages/checkout-step-1" class="back-link">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="2"/>
          </svg>
          Back to Address
        </a>
        <h1>Shipping Method</h1>
      </div>

      <!-- Delivery Address Summary -->
      <div class="info-summary">
        <div class="summary-header">
          <h3>Delivery Address</h3>
          <a href="/pages/checkout-step-1" class="edit-link">Edit</a>
        </div>
        <div class="summary-content" id="addressSummary">
          <!-- Will be populated from sessionStorage -->
        </div>
      </div>

      <!-- Shipping Methods -->
      <div class="form-section">
        <h2>Select Shipping Method</h2>
        
        <div class="shipping-methods">
          <!-- Standard Shipping -->
          <div class="shipping-option">
            <input 
              type="radio" 
              name="shipping_method" 
              id="standard" 
              value="standard"
              data-price="0"
              checked
            >
            <label for="standard">
              <div class="method-info">
                <div class="method-name">Standard Shipping</div>
                <div class="method-time">5-7 Business Days</div>
              </div>
              <div class="method-price">FREE</div>
            </label>
          </div>

          <!-- Express Shipping -->
          <div class="shipping-option">
            <input 
              type="radio" 
              name="shipping_method" 
              id="express" 
              value="express"
              data-price="15"
            >
            <label for="express">
              <div class="method-info">
                <div class="method-name">Express Shipping</div>
                <div class="method-time">2-3 Business Days</div>
              </div>
              <div class="method-price">$15.00</div>
            </label>
          </div>

          <!-- Overnight Shipping -->
          <div class="shipping-option">
            <input 
              type="radio" 
              name="shipping_method" 
              id="overnight" 
              value="overnight"
              data-price="30"
            >
            <label for="overnight">
              <div class="method-info">
                <div class="method-name">Overnight Shipping</div>
                <div class="method-time">Next Business Day</div>
              </div>
              <div class="method-price">$30.00</div>
            </label>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="checkout-actions">
        <a href="/pages/checkout-step-1" class="btn btn-secondary">Back</a>
        <button type="button" class="btn btn-primary" id="continueToPayment">
          Continue to Payment
        </button>
      </div>
    </div>

    <!-- Order Summary Sidebar -->
    <div class="checkout-sidebar">
      <div class="order-summary">
        <h3>Order Summary</h3>
        
        <div class="cart-items">
          {% for item in cart.items %}
          <div class="cart-item">
            <div class="item-image">
              {% if item.image %}
                {{ item.image | image_url: width: 80 | image_tag: alt: item.title }}
              {% endif %}
            </div>
            <div class="item-details">
              <div class="item-title">{{ item.product.title }}</div>
              <div class="item-variant">{{ item.variant.title }}</div>
              <div class="item-quantity">Qty: {{ item.quantity }}</div>
            </div>
            <div class="item-price">
              {{ item.final_line_price | money }}
            </div>
          </div>
          {% endfor %}
        </div>

        <div class="summary-totals">
          <div class="summary-row">
            <span>Subtotal</span>
            <span id="subtotal">{{ cart.total_price | money }}</span>
          </div>
          <div class="summary-row">
            <span>Shipping</span>
            <span id="shippingCost">FREE</span>
          </div>
          <div class="summary-row total">
            <span>Total</span>
            <span id="totalPrice">{{ cart.total_price | money }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Load address from sessionStorage
  const addressData = JSON.parse(sessionStorage.getItem('checkoutAddress') || '{}');
  const addressSummary = document.getElementById('addressSummary');
  
  if (addressData.email) {
    addressSummary.innerHTML = `
      <p><strong>${addressData.first_name || ''} ${addressData.last_name || ''}</strong></p>
      <p>${addressData.address1 || ''}</p>
      ${addressData.address2 ? `<p>${addressData.address2}</p>` : ''}
      <p>${addressData.city || ''}, ${addressData.province || ''} ${addressData.zip || ''}</p>
      <p>${addressData.country || ''}</p>
      <p>Email: ${addressData.email}</p>
      <p>Phone: ${addressData.phone}</p>
    `;
  }

  // Handle shipping method selection
  const shippingOptions = document.querySelectorAll('input[name="shipping_method"]');
  const subtotal = {{ cart.total_price | divided_by: 100.0 }};
  
  shippingOptions.forEach(option => {
    option.addEventListener('change', function() {
      const shippingPrice = parseFloat(this.dataset.price);
      const total = subtotal + shippingPrice;
      
      document.getElementById('shippingCost').textContent = 
        shippingPrice === 0 ? 'FREE' : `$${shippingPrice.toFixed(2)}`;
      document.getElementById('totalPrice').textContent = `$${total.toFixed(2)}`;
    });
  });

  // Continue to payment
  document.getElementById('continueToPayment').addEventListener('click', function() {
    const selectedShipping = document.querySelector('input[name="shipping_method"]:checked');
    
    if (!selectedShipping) {
      alert('Please select a shipping method');
      return;
    }

    // Save shipping method
    const shippingData = {
      method: selectedShipping.value,
      price: selectedShipping.dataset.price,
      label: selectedShipping.nextElementSibling.querySelector('.method-name').textContent
    };
    sessionStorage.setItem('checkoutShipping', JSON.stringify(shippingData));
    
    // Redirect to step 3
    window.location.href = '/pages/checkout-step-3';
  });
});
</script>

{% schema %}
{
  "name": "Checkout Step 2",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shipping Method"
    }
  ]
}
{% endschema %}