<script src="https://cdn.tailwindcss.com"></script>

<div class="shopify-section">
  <div class="max-w-{{ section.settings.container_width }}px mx-auto p-6 bg-white">

    <div class="flex justify-between items-center mb-12 text-xs md:text-sm font-medium text-slate-400">
      <div class="flex flex-col items-center gap-2 opacity-50">
        <span>Step 1</span>
        <span class="text-black text-lg">Address</span>
      </div>
      <div class="flex flex-col items-center gap-2 border-b-2 border-black pb-2 text-black">
        <span>Step 2</span>
        <span class="text-black text-lg font-bold">Shipping</span>
      </div>
      <div class="flex flex-col items-center gap-2 opacity-50">
        <span>Step 3</span>
        <span class="text-black text-lg">Payment</span>
      </div>
    </div>

    <h2 class="text-xl font-bold text-slate-900 mb-6">{{ section.settings.title }}</h2>

    <div class="space-y-4">
      {% for block in section.blocks %}
        <label class="relative flex items-center p-4 border rounded-xl cursor-pointer transition-all hover:bg-slate-50 border-slate-200 has-[:checked]:border-black has-[:checked]:ring-1 has-[:checked]:ring-black">
          <input
            type="radio"
            name="attributes[Shipment Method]"
            value="{{ block.settings.method_name }}"
            class="w-5 h-5 accent-black"
            {% if forloop.first %}
            checked{% endif %}>

          <div class="ml-4 flex flex-1 flex-col md:flex-row md:items-center justify-between gap-2">
            <div class="flex items-center gap-3">
              <span class="font-bold text-slate-900">{{ block.settings.price_label }}</span>
              <span class="text-slate-500 text-sm">{{ block.settings.description }}</span>
            </div>

            {% if block.type == 'scheduled_option' %}
              <div class="flex items-center text-slate-400 text-sm font-medium border rounded px-2">
                <input
                  type="date"
                  name="attributes[Scheduled Date]"
                  class="bg-transparent outline-none py-1">
              </div>
            {% else %}
              <span class="text-slate-900 font-medium text-sm">{{ block.settings.delivery_date }}</span>
            {% endif %}
          </div>
        </label>
      {% endfor %}
    </div>

    <div class="flex flex-col md:flex-row justify-end gap-4 mt-12">
      <button type="button" class="px-12 py-3 border border-slate-900 rounded-md font-medium hover:bg-slate-50 transition-colors order-2 md:order-1">
        Back
      </button>
      <button
        type="submit"
        name="checkout"
        class="px-12 py-3 bg-black text-white rounded-md font-medium hover:bg-slate-800 transition-colors order-1 md:order-2">
        Next
      </button>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Custom Shipping Picker",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Shipment Method"
      }, {
        "type": "range",
        "id": "container_width",
        "min": 600,
        "max": 1200,
        "step": 50,
        "unit": "px",
        "label": "Section Width",
        "default": 800
      }
    ],
    "blocks": [
      {
        "type": "shipping_option",
        "name": "Shipping Option",
        "settings": [
          {
            "type": "text",
            "id": "method_name",
            "label": "Method ID (Hidden)",
            "default": "Regular"
          }, {
            "type": "text",
            "id": "price_label",
            "label": "Price Text",
            "default": "Free"
          }, {
            "type": "text",
            "id": "description",
            "label": "Description",
            "default": "Regular shipment"
          }, {
            "type": "text",
            "id": "delivery_date",
            "label": "Delivery Date Text",
            "default": "17 Oct, 2023"
          }
        ]
      }, {
        "type": "scheduled_option",
        "name": "Scheduled Option",
        "limit": 1,
        "settings": [
          {
            "type": "text",
            "id": "method_name",
            "label": "Method ID",
            "default": "Scheduled"
          }, {
            "type": "text",
            "id": "price_label",
            "label": "Price Text",
            "default": "Schedule"
          }, {
            "type": "text",
            "id": "description",
            "label": "Description",
            "default": "Pick a date for delivery"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Custom Shipping Picker",
        "blocks": [
          {
            "type": "shipping_option"
          }, {
            "type": "shipping_option",
            "settings": {
              "price_label": "$8.50",
              "description": "Express"
            }
          }, {
            "type": "scheduled_option"
          }
        ]
      }
    ]
  }
{% endschema %}