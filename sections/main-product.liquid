<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}
<div class="max-w-[1200px] mx-auto px-2">
  {% render 'breadcrumb' %}
</div>
  <section class="pt-24 pb-24 px-24">
  <div class="max-w-[1200px] mx-auto">
    <div class="grid grid-cols-[90px_520px_1fr] gap-12 items-start">

      <!-- Thumbnails -->
      <div class="flex flex-col gap-4 pt-2">
        {% for media in product.media %}
          {% if media.preview_image %}
            <button
  type="button"
  class="product-thumbnail w-[70px] h-[70px] rounded-xl overflow-hidden border border-gray-200"
  data-full="{{ media.preview_image | image_url: width: 900 }}"
>
  {{ media.preview_image
    | image_url: width: 120
    | image_tag: class: "w-full h-full object-cover block" }}
</button>
          {% endif %}
        {% endfor %}
      </div>


      <!-- Main Image -->
      <div class="flex justify-center">
  {% assign main_image = product.featured_image %}
  {% if main_image %}
    <img
        id="ProductMainImage"
        src="{{ main_image | image_url: width: 900 }}"
        alt="{{ main_image.alt | escape }}"
        class="max-w-[440px] w-full object-contain block"
      >
  {% endif %}
</div>


      <!-- Product Info -->
      <div class="flex flex-col justify-start w-full max-w-[420px] pt-2 space-y-5">
        <h1 class="font-inter text-[40px] leading-[40px] font-bold text-black mb-4">
          {{ product.title }}
        </h1>

        {% assign variant = product.selected_or_first_available_variant %}
        <div id="price-{{ section.id }}" class="flex items-baseline gap-4 whitespace-nowrap">
          {% if variant.compare_at_price > variant.price %}
            <span class="text-[32px] font-medium text-black leading-none">
              {{ variant.price | money }}
            </span>
            <span class="text-[24px] text-gray-400 line-through leading-none">
              {{ variant.compare_at_price | money }}
            </span>
          {% else %}
            <span class="text-[32px] font-medium text-black leading-none">
              {{ variant.price | money }}
            </span>
          {% endif %}
        </div>
          {% for block in section.blocks %}
  {% case block.type %}
    {% when 'variant_picker' %}
      {% render 'product-variant-picker',
        product: product,
        block: block,
        section: section
      %}
  {% endcase %}
{% endfor %}
{% comment %} product-features {% endcomment %}
     {% render 'product-features', product: product %}
     <div class="mt-10">

  <div
    id="product-description"
    class="text-gray-700 text-[14px] leading-relaxed overflow-hidden
           transition-all duration-300"
    style="
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    "
  >
    {{ product.description }}
  </div>

  <button
    id="toggle-description"
    class="mt-2 text-[14px] font-medium text-black underline hidden cursor-pointer"
    type="button"
  >
    See more
  </button>

</div>


<script>
  document.addEventListener("DOMContentLoaded", function () {
    const desc = document.getElementById("product-description");
    const btn = document.getElementById("toggle-description");

    if (!desc || !btn) return;

    // Check if description exceeds 2 lines
    if (desc.scrollHeight > desc.clientHeight + 5) {
      btn.classList.remove("hidden");
    }

    let expanded = false;

    btn.addEventListener("click", function () {
      expanded = !expanded;

      if (expanded) {
        desc.style.webkitLineClamp = "unset";
        desc.style.overflow = "visible";
        btn.textContent = "See less";
      } else {
        desc.style.webkitLineClamp = "2";
        desc.style.overflow = "hidden";
        btn.textContent = "See more";
      }
    });
  });
</script>


     <div class="mt-10 flex gap-4 text-[16px]">

  <!-- Add to Wishlist -->
  <div class="flex gap-4 w-full">

  <!-- Wishlist -->
  <button
    type="button"
    class="flex-1 h-[52px] rounded-xl border border-black text-black font-medium"
  >
    Add to Wishlist
  </button>

  <!-- Add to Cart -->
  <form
    id="product-form-{{ section.id }}"
    action="/cart/add"
    method="post"
    class="flex-1"
  >
    <input
      type="hidden"
      name="id"
      value="{{ product.selected_or_first_available_variant.id }}"
    >

    <input type="hidden" name="quantity" value="1">

    <button
      type="submit"
      class="w-full h-[52px] rounded-xl bg-black text-white font-medium hover:bg-gray-900"
    >
      Add to Cart
    </button>
  </form>

</div>



</div>
      <div class="mt-8">
  {% render 'product-benefits', product: product %}
</div>
      </div>

    </div>
  </div>
</section>





{% stylesheet %}
/* Thumbnail images default state */
.product-thumbnail img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Active / selected thumbnail */
.product-thumbnail.is-active img {
  opacity: 1;
  transform: scale(1.05);
}

/* Hover effect */
.product-thumbnail:hover img {
  opacity: 0.75;
}



{% endstylesheet %}

{% javascript %}
  document.addEventListener("DOMContentLoaded", () => {
  const mainImage = document.getElementById("ProductMainImage");
  const thumbnails = document.querySelectorAll(".product-thumbnail");

  if (!mainImage || !thumbnails.length) return;

  function updateMainImage(button) {
    const src = button.dataset.full;
    if (!src) return;

    mainImage.src = src;

    thumbnails.forEach((thumb) => {
      thumb.classList.remove("is-active");
    });

    button.classList.add("is-active");
  }

  thumbnails.forEach((button, index) => {
    if (index === 0) {
      button.classList.add("is-active");
    }

    button.addEventListener("click", () => {
      updateMainImage(button);
    });
  });
});

{% endjavascript %}



</product-info>

