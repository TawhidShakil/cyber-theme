<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@100;300;400;500;600&display=swap" rel="stylesheet">

<style>
  .font-inter {
    font-family: 'Inter', sans-serif;
  }

  /* Responsive Layout System */
  .mobile-layout {
    display: flex;
    flex-direction: column;
  }
  
  .desktop-layout {
    display: none;
  }

  @media (min-width: 1024px) {
    .desktop-layout {
      display: flex !important;
      flex-direction: row;
    }
    .mobile-layout {
      display: none !important;
    }
  }

  /* Scroll Reveal Animations */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .reveal.active {
    opacity: 1;
    transform: translateY(0);
  }

  .delay-200 {
    transition-delay: 200ms;
  }
  
  .delay-400 {
    transition-delay: 400ms;
  }

  /* Hover Effects */
  .hover-zoom {
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .group:hover .hover-zoom {
    transform: scale(1.05);
  }

  .shop-btn {
    transition: all 0.3s ease;
    display: inline-block;
  }
  
  .shop-btn:hover {
    background-color: black;
    color: white;
  }

  /* Fix image positioning for desktop */
  .product-card {
    position: relative;
    overflow: hidden;
  }

  /* Ensure proper spacing and prevent overlap */
  @media (min-width: 1024px) {
    .ps5-section {
      min-height: 360px;
    }
    
    .small-cards {
      min-height: 360px;
    }
    
    .mac-section {
      min-height: 720px;
    }

    /* PS5 Image positioning */
    .ps5-image {
      position: absolute;
      left: 0;
      top: 0;
      transform: translateY(-50%);
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: left center;
    }

    .ps5-content {
      margin-left: auto;
      width: 50%;
    }

    /* AirPods positioning */
    .airpods-image {
      position: absolute;
      left: -8%;
      top: 0;
      transform: translateY(-50%);
      width: 50%;
      height: 100%;
      object-fit: contain;
    }

    .airpods-content {
      margin-left: auto;
      width: 45%;
    }

    /* Vision Pro positioning */
    .vision-image {
      position: absolute;
      left: -10%;
      top: 0;
      transform: translateY(-50%);
      width: 50%;
      height: 85%;
      object-fit: contain;
    }

    .vision-content {
      margin-left: auto;
      width: 45%;
    }

    /* MacBook positioning */
    .mac-image {
      position: absolute;
      right: -5%;
      top: ;
      transform: translateY(-50%);
      width: 75%;
      height: 85%;
      object-fit: contain;
      object-position: right center;
    }

    .mac-content {
      margin-right: auto;
      width: 45%;
    }
  }
</style>

<section class="w-full max-w-[1440px] mx-auto overflow-hidden font-inter">
  <!-- DESKTOP LAYOUT (1024px+) -->
  <div class="desktop-layout">
    <!-- Left Column -->
    <div class="flex flex-col flex-1">
      <!-- PlayStation 5 Section -->
      <div class="ps5-section relative flex items-center px-8 lg:px-12 bg-white group">
        {% if section.settings.ps5_image != blank %}
          <img 
            src="{{ section.settings.ps5_image | image_url: width: 800 }}" 
            alt="{{ section.settings.ps5_title }}"
            class="ps5-image hover-zoom reveal"
            loading="lazy">
        {% endif %}

        <div class="ps5-content relative z-10 flex flex-col items-start text-left gap-3 py-12 reveal delay-200">
          <h2 class="text-[34px] lg:text-[49px] font-medium text-black leading-tight">{{ section.settings.ps5_title }}</h2>
          <p class="text-sm font-medium text-[#909090] leading-relaxed max-w-[340px]">{{ section.settings.ps5_text }}</p>
        </div>
      </div>

      <!-- Small Cards Row -->
      <div class="flex flex-row">
        <!-- AirPods Max -->
        <div class="small-cards product-card flex-1 flex items-center  bg-[#EDEDED] group">
          {% if section.settings.airpods_image != blank %}
            <img 
              src="{{ section.settings.airpods_image | image_url: width: 500 }}" 
              alt="Apple AirPods Max"
              class="airpods-image hover-zoom reveal"
              loading="lazy">
          {% endif %}
          
          <div class="airpods-content relative z-10 flex flex-col items-start text-left py-12 reveal delay-400">
            <h3 class="text-2xl lg:text-[29px] font-light text-black leading-tight">
              Apple AirPods <span class="font-bold">Max</span>
            </h3>
            <p class="text-sm font-medium text-[#919191] mt-2 max-w-[160px]">{{ section.settings.airpods_text }}</p>
          </div>
        </div>

        <!-- Vision Pro -->
        <div class="small-cards product-card flex-1 flex items-center px-4 lg:px-6 bg-[#353535] group">
          {% if section.settings.vision_image != blank %}
            <img 
              src="{{ section.settings.vision_image | image_url: width: 600 }}" 
              alt="Apple Vision Pro"
              class="vision-image hover-zoom reveal"
              loading="lazy">
          {% endif %}
          
          <div class="vision-content relative z-10 flex flex-col items-start text-left py-12 reveal delay-400">
            <h3 class="text-2xl lg:text-[29px] text-white leading-tight font-light">
              Apple Vision <span class="font-bold">Pro</span>
            </h3>
            <p class="text-sm font-medium text-[#919191] mt-2 max-w-[180px]">{{ section.settings.vision_text }}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column - MacBook -->
    <div class="mac-section product-card flex-1 flex items-center bg-[#EDEDED] py-16 px-8 lg:px-12 group">
      {% if section.settings.mac_image != blank %}
        <img 
          src="{{ section.settings.mac_image | image_url: width: 1000 }}" 
          alt="Macbook Air"
          class="mac-image hover-zoom reveal"
          loading="lazy">
      {% endif %}

      <div class="mac-content relative z-20 flex flex-col items-start text-left gap-4 reveal delay-200">
        <h2 class="text-5xl lg:text-[64px] font-mixed text-black leading-tight">
          <span class="font-mixed block">Macbook</span>
          <span class="font-bold">Air</span>
        </h2>
        <p class="text-[14px] font-medium text-[#919191] max-w-[300px]">{{ section.settings.mac_text }}</p>
        <a href="{{ section.settings.mac_link }}" class="shop-btn text-[16px] font-bold border border-black py-4 px-12 inline-block text-black">
          Shop Now
        </a>
      </div>
    </div>
  </div>

  <!-- MOBILE LAYOUT (<1024px) -->
  <div class="mobile-layout">
    <!-- AirPods Max -->
    <div class="relative flex flex-col items-center justify-center py-12 px-6 bg-[#EDEDED] overflow-hidden min-h-[400px]">
      {% if section.settings.airpods_image != blank %}
        <img 
          src="{{ section.settings.airpods_image_mobile | default: section.settings.airpods_image | image_url: width: 400 }}" 
          alt="Apple AirPods Max"
          class="w-full max-w-[220px] object-contain mb-6 hover-zoom reveal"
          loading="lazy">
      {% endif %}
      
      <div class="flex flex-col items-center text-center max-w-[280px] reveal delay-200">
        <h3 class="text-3xl font-light text-black leading-tight">
          Apple AirPods <span class="font-bold">Max</span>
        </h3>
        <p class="text-sm font-medium text-[#919191] mt-2">{{ section.settings.airpods_text }}</p>
      </div>
    </div>

    <!-- Vision Pro -->
    <div class="relative flex flex-col items-center justify-center py-12 px-6 bg-[#353535] overflow-hidden min-h-[400px]">
      {% if section.settings.vision_image != blank %}
        <img 
          src="{{ section.settings.vision_image_mobile | default: section.settings.vision_image | image_url: width: 500 }}" 
          alt="Apple Vision Pro"
          class="w-full max-w-[280px] object-contain mb-6 hover-zoom reveal"
          loading="lazy">
      {% endif %}
      
      <div class="flex flex-col items-center text-center max-w-[280px] reveal delay-200">
        <h3 class="text-3xl text-white leading-tight font-light">
          Apple Vision <span class="font-bold">Pro</span>
        </h3>
        <p class="text-sm font-medium text-[#919191] mt-2">{{ section.settings.vision_text }}</p>
      </div>
    </div>

    <!-- PlayStation 5 -->
    <div class="relative flex flex-col items-center justify-center px-6 py-12 bg-white overflow-hidden min-h-[400px]">
      {% if section.settings.ps5_image != blank %}
        <img 
          src="{{ section.settings.ps5_image_mobile | default: section.settings.ps5_image | image_url: width: 600 }}" 
          alt="{{ section.settings.ps5_title }}"
          class="w-full max-w-[280px] object-contain mb-8 hover-zoom reveal"
          loading="lazy">
      {% endif %}

      <div class="flex flex-col items-center text-center max-w-[320px] gap-2 reveal delay-200">
        <h2 class="text-4xl font-medium text-black">{{ section.settings.ps5_title }}</h2>
        <p class="text-sm font-medium text-[#909090] leading-relaxed">{{ section.settings.ps5_text }}</p>
      </div>
    </div>

    <!-- MacBook Air -->
    <div class="relative flex flex-col items-center justify-center bg-[#EDEDED] py-16 px-6 overflow-hidden min-h-[500px]">
      {% if section.settings.mac_image != blank %}
        <img 
          src="{{ section.settings.mac_image_mobile | default: section.settings.mac_image | image_url: width: 800 }}" 
          alt="Macbook Air"
          class="w-full max-w-[420px] mb-10 hover-zoom reveal"
          loading="lazy">
      {% endif %}

      <div class="flex flex-col items-center text-center gap-4 max-w-[320px] reveal delay-200">
        <h2 class="text-5xl text-black leading-tight">
          <span class="font-light block">Macbook</span>
          <span class="font-bold">Air</span>
        </h2>
        <p class="text-sm font-medium text-[#919191] max-w-[300px]">{{ section.settings.mac_text }}</p>
        <a href="{{ section.settings.mac_link }}" class="shop-btn mt-4 px-12 py-3 border border-black rounded-md text-base font-medium">
          Shop Now
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const observerOptions = {
      threshold: 0.1,
      rootMargin: "0px 0px -50px 0px"
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('active');
        }
      });
    }, observerOptions);

    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  });
</script>

