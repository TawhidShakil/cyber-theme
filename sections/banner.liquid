<section>
    <div class="px-12 md:px-64 flex flex-col md:flex-row justify-between h-auto md:max-h-[610px] text-white" style="background-color: {{ section.settings.banner_background_color }};">

    <!-- LEFT CONTENT -->
    <div class="w-full md:w-[60%] flex flex-col justify-center font-[var(--font-heading)]">
        <div class="flex flex-col items-center md:items-start gap-5 pt-16 md:pt-0">
            <p class="text-2xl opacity-60 font-semibold pt-4 md:pt-0">{{ section.settings.banner_text }}</p>

            <h1 class="text-7xl md:text-8xl font-extralight text-white pt-4 md:pt-0
max-w-[200px] md:max-w-none
text-center md:text-start">
                {{ section.settings.banner_title }}
                <span class="text-white font-bold"> {{ section.settings.banner_title2 }}</span>
            </h1>
 
            <p class="text-base md:text-xl text-center  opacity-60 font-medium py-4 md:py-0 max-w-[200px] md:w-full">{{ section.settings.banner_description }}</p>

            {% if section.settings.banner_button_link != blank %}
                <a href="{{ section.settings.banner_button_link }}" class="text-xs font-bold text-white border border-white py-4 px-12 inline-block">
                    {{ section.settings.banner_button_text }}
                </a>
            {% else %}
                <button class="text-sm font-bold text-white border rounded-[var(--radius-sm)] border-white py-4 px-14">
                    {{ section.settings.banner_button_text }}
                </button>
            {% endif %}
        </div>
    </div>

    <!-- RIGHT IMAGE -->
    <div class="w-full h-full sm:w-full h-full md:max-h-[632px] md:max-w-[40%] flex items-center justify-center ">
        {% if section.settings.banner_image != blank %}
          <img 
  src="{{ section.settings.banner_image | image_url: width: 800 }}" 
  alt="Banner Image"
  class="
    w-full max-w-[220px]
    sm:max-w-[300px]
    md:max-w-[380px]
    lg:max-w-[480px]
    h-auto object-contain
  "
/>

        {% endif %}
    </div>

</div>
</section>

{% schema %}
{
    "name": "Banner",
    "settings": [
        {
            "type": "image_picker",
            "id": "banner_image",
            "label": "Banner Image"
        },
        {
            "type": "color",
            "id": "banner_background_color",
            "label": "Banner Background Color",
            "default": "#211C24"
        },
        {
            "type": "text",
            "id": "banner_text",
            "label": "Banner Text",
            "default": "Banner Text"
        },
        {
            "type": "text",
            "id": "banner_title",
            "label": "Banner Title",
            "default": "Banner Title"
        },
        {
            "type": "text",
            "id": "banner_title2",
            "label": "Banner Title 2",
            "default": "Pro"
        },
        {
            "type": "text",
            "id": "banner_description",
            "label": "Banner Description",
            "default": "Banner Description"
        },
        {
            "type": "text",
            "id": "banner_button_text",
            "label": "Banner Button Text",
            "default": "Shop now"
        },
        {
            "type": "url",
            "id": "banner_button_link",
            "label": "Banner Button Link"
        }
    ],
    "presets": [
        {
            "category": "Content",
            "name": "Hero Content"
        }
    ]
}
{% endschema %}
