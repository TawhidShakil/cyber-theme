<div class="w-full relative group-slider overflow-hidden" style="background-color: {{ section.settings.background_color }};">
    <div class="flex w-full min-h-[500px] md:min-h-[550px] overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar md:flex-row md:overflow-visible" id="slider-{{ section.id }}">

        {% for collection in section.settings.collections %}
        {%- comment -%} Determine Background and Text Colors based on position {%- endcomment -%}
        {%- assign bg_color = '#ffffff' -%}
        {%- assign text_color = '#000000' -%}
        {%- assign btn_class = 'border-black text-black hover:bg-black hover:text-white' -%}
        
        {%- if forloop.index == 2 -%}
            {%- assign bg_color = '#F5F5F5' -%}
        {%- elsif forloop.index == 3 -%}
            {%- assign bg_color = '#EBEBEB' -%}
        {%- elsif forloop.index == 4 -%}
            {%- assign bg_color = '#2D2D2D' -%}
            {%- assign text_color = '#FFFFFF' -%}
            {%- assign btn_class = 'border-white text-white hover:bg-white hover:text-black' -%}
        {%- endif -%}
        
        <div class="min-w-full md:min-w-0 md:flex-1 snap-center flex flex-col items-start justify-end p-8 md:p-12 transition-all duration-300" 
             style="background-color: {{ bg_color }};">

            <div class="w-full h-[220px] md:h-[260px] mb-8 flex items-center justify-center md:justify-start">
                {% if collection.featured_image %}
                    <img 
                        src="{{ collection.featured_image | image_url: width: 800 }}" 
                        alt="{{ collection.title }}"
                        class="max-h-full w-auto object-contain transition-transform duration-500 hover:scale-105"
                    >   
                {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'w-full h-full opacity-20' }}
                {% endif %}
            </div>

            <div class="w-full
                flex flex-col
                items-center justify-center
                md:items-start md:justify-start">
                <h2 class="mb-4 leading-tight font-light tracking-tight" 
                    style="color: {{ text_color }}; font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }}; font-size: {{ section.settings.heading_font_size }}px;">
                    {{ collection.title }}
                </h2>

                {% if collection.description != blank %}
                    <p class="mb-8 opacity-70 leading-relaxed max-w-[280px]" 
                       style="color: {{ text_color }}; font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }}; font-size: {{ section.settings.body_font_size }}px;">
                        {{ collection.description | strip_html | truncate: 120 }}
                    </p>
                {% endif %}

                <a href="{{ collection.url }}" 
                   class="inline-block border rounded-sm px-10 py-3 text-sm font-medium tracking-wide transition-all duration-300 {{ btn_class }}">
                    Shop Now
                </a>
            </div>
        </div>
        {% endfor %}

    </div>

    <div class="flex justify-center gap-2 py-6 md:hidden">
        {% for collection in section.settings.collections %}
            <div class="w-1.5 h-1.5 rounded-full bg-gray-400 transition-all duration-300 slider-dot-{{ section.id }}" style="opacity: {% if forloop.first %}1{% else %}0.3{% endif %};"></div>
        {% endfor %}
    </div>

    <style>
        /* Hide scrollbars */
        #slider-{{ section.id }} {
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
        #slider-{{ section.id }}::-webkit-scrollbar {
            display: none;
        }
        /* Mobile Snapping */
        @media screen and (max-width: 767px) {
            #slider-{{ section.id }} {
                scroll-snap-type: x mandatory;
            }
            #slider-{{ section.id }} > div {
                scroll-snap-align: center;
            }
        }
        .group-slider h2 { font-weight: 300; }
    </style>

    <script>
    document.addEventListener("DOMContentLoaded", function() {
        const slider = document.getElementById('slider-{{ section.id }}');
        const dots = document.querySelectorAll('.slider-dot-{{ section.id }}');
        
        if (!slider || dots.length === 0) return;

        // Update Dots on Scroll for Mobile
        const updateDots = () => {
            const width = slider.offsetWidth;
            const index = Math.round(slider.scrollLeft / width);
            dots.forEach((dot, i) => {
                dot.style.opacity = (i === index) ? "1" : "0.3";
                dot.style.transform = (i === index) ? "scale(1.2)" : "scale(1)";
            });
        };

        slider.addEventListener('scroll', updateDots);
    });
    </script>
</div>

{% schema %}
{
  "name": "Collections Banner V2",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Select Collections (Max 4)",
      "limit": 4
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading Font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 15,
      "max": 60,
      "step": 1,
      "default": 48,
      "unit": "px",
      "label": "Heading Font Size"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body Font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "body_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 14,
      "unit": "px",
      "label": "Body Font Size"
    }
  ],
  "presets": [
    {
      "name": "Collections Banner V2"
    }
  ]
}
{% endschema %}