<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  .font-inter { font-family: 'Inter', sans-serif; }
  /* Hides scrollbar for Chrome, Safari and Opera */
  .no-scrollbar::-webkit-scrollbar { display: none; }
  /* Hides scrollbar for IE, Edge and Firefox */
  .no-scrollbar {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>

<section class="max-w-[1440px] mx-auto py-12 md:py-20 px-4 md:px-10 lg:px-[160px] font-inter bg-white">
  
  <div class="mb-8 flex justify-between items-center">
    <h2 class="text-[24px] font-medium tracking-tight text-black">
      {{ section.settings.title | default: 'Discounts up to -50%' }}
    </h2>
  </div>

  {% comment %} 
    flex-nowrap: Forces all products onto one line for scrolling.
    overflow-x-auto: Enables the horizontal scroll.
    snap-x snap-mandatory: Ensures items 'snap' into place.
  {% endcomment %}
  <div class="flex flex-nowrap gap-4 overflow-x-auto no-scrollbar snap-x snap-mandatory pb-4">
    {% assign discount_collection = collections[section.settings.discount_collection] %}
    
    {% if discount_collection != blank and discount_collection.products_count > 0 %}
      {% for product in discount_collection.products %}
        {% render 'product-card-item', card_product: product %}
      {% endfor %}
    {% else %}
      {% comment %} Responsive Skeleton Loaders {% endcomment %}
      {% for i in (1..8) %}
        <div class="flex-none w-[calc(50%-8px)] lg:w-[calc(25%-12px)] bg-[#F6F6F6] rounded-[10px] p-6 animate-pulse h-[400px]">
           <div class="w-full aspect-square bg-gray-200 rounded-md mb-4"></div>
           <div class="h-4 bg-gray-200 w-3/4 mb-2 mx-auto"></div>
           <div class="h-6 bg-gray-200 w-1/2 mx-auto"></div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Discount Section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Discounts up to -50%"
    },
    {
      "type": "collection",
      "id": "discount_collection",
      "label": "Select Discount Collection"
    }
  ],
  "presets": [
    {
      "name": "Discount Section",
      "category": "Products"
    }
  ]
}
{% endschema %}