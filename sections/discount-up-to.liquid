<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  .font-inter { font-family: 'Inter', sans-serif; }
</style>

<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  .font-inter { font-family: 'Inter', sans-serif; }
  /* Hides scrollbar for Chrome, Safari and Opera */
  .no-scrollbar::-webkit-scrollbar { display: none; }
  /* Hides scrollbar for IE, Edge and Firefox */
  .no-scrollbar {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>

<section class="max-w-[1440px] mx-auto py-12 md:py-20 px-4 md:px-[160px] font-inter bg-white">
  
  <div class="mb-8 flex justify-between items-center">
    <h2 class="text-[24px] font-medium tracking-tight text-black">
      {{ section.settings.title | default: 'Discounts up to -50%' }}
    </h2>
  </div>

  <div class="flex gap-4 overflow-x-auto no-scrollbar snap-x snap-mandatory">
    {% assign discount_collection = collections[section.settings.discount_collection] %}
    
    {% if discount_collection != blank and discount_collection.products_count > 0 %}
      {% for product in discount_collection.products %}
        <div class="flex-none w-[calc(50%-8px)] lg:w-[calc(25%-12px)] snap-start">
           <div class="bg-[#F6F6F6] rounded-[10px] p-4 md:p-6 flex flex-col items-center text-center h-full relative">
              <button class="absolute top-4 right-4 text-gray-400 hover:text-red-500">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                </svg>
              </button>

              <div class="w-full aspect-square flex items-center justify-center mb-4">
                <img src="{{ product.featured_image | img_url: '400x' }}" alt="{{ product.title }}" class="max-h-full object-contain">
              </div>

              <h3 class="text-[16px] font-medium text-black mb-2 line-clamp-2 min-h-[48px]">
                {{ product.title }}
              </h3>

              <p class="text-[24px] font-semibold text-black mb-6">
                {{ product.price | money_without_trailing_zeros }}
              </p>

              <button class="w-full bg-black text-white py-3 rounded-[8px] text-[14px] font-medium hover:bg-gray-800 transition-colors mt-auto">
                Buy Now
              </button>
           </div>
        </div>
      {% endfor %}
    {% else %}
      {% for i in (1..4) %}
        <div class="flex-none w-[calc(50%-8px)] lg:w-[calc(25%-12px)] bg-[#F6F6F6] rounded-[10px] p-6 animate-pulse h-[450px]"></div>
      {% endfor %}
    {% endif %}
  </div>
</section>

<style>
  /* Clean UI: Hides the scrollbar while allowing swiping */
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>

{% schema %}
{
  "name": "Discount Section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Discounts up to -50%"
    },
    {
      "type": "collection",
      "id": "discount_collection",
      "label": "Select Discount Collection"
    }
  ],
  "presets": [
    {
      "name": "Discount Section",
      "category": "Products"
    }
  ]
}
{% endschema %}