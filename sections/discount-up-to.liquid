<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  .font-inter { font-family: 'Inter', sans-serif; }
</style>

<section class="max-w-[1440px] mx-auto pt-20 pb-20 px-[160px] font-inter bg-white overflow-hidden">
  
  <div class="mb-10 flex justify-between items-center">
    <h2 class="text-[24px] font-medium tracking-tight text-black">
      {{ section.settings.title | default: 'Discounts up to -50%' }}
    </h2>
    </div>

  <div id="discountSlider" class="flex gap-6 overflow-x-auto scrollbar-hide scroll-smooth snap-x snap-mandatory">
    {% assign discount_collection = section.settings.discount_collection %}
    
    {% if discount_collection != blank %}
      {% for product in discount_collection.products %}
        <div class="flex-none w-[calc((100%-72px)/4)] snap-start">
          {% render 'product-card-item', card_product: product %}
        </div>
      {% endfor %}
    {% else %}
      {% for i in (1..4) %}
        <div class="flex-none w-[calc((100%-72px)/4)] bg-[#F6F6F6] rounded-[10px] p-6 animate-pulse h-[400px]"></div>
      {% endfor %}
    {% endif %}
  </div>
</section>

<style>
  /* Clean UI: Hides the scrollbar while allowing swiping */
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>

{% schema %}
{
  "name": "Discount Section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Discounts up to -50%"
    },
    {
      "type": "collection",
      "id": "discount_collection",
      "label": "Select Discount Collection"
    }
  ],
  "presets": [
    {
      "name": "Discount Section",
      "category": "Products"
    }
  ]
}
{% endschema %}