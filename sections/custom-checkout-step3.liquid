<!-- sections/custom-checkout-step3.liquid -->
<div class="checkout-container step-3" data-step="3" style="display: none;">
  <div class="checkout-header">
    <div class="logo">
      <h1>cyber</h1>
    </div>
    <div class="checkout-steps">
      <div class="step completed">
        <span class="step-number">✓</span>
        <span class="step-label">Bag / Address</span>
      </div>
      <div class="step completed">
        <span class="step-number">✓</span>
        <span class="step-label">Shipping</span>
      </div>
      <div class="step active">
        <span class="step-number">3</span>
        <span class="step-label">Payment</span>
      </div>
    </div>
  </div>

  <div class="checkout-content-split">
    <div class="checkout-left">
      <h2 class="section-title">Summary</h2>
      
      <div class="order-items">
        <!-- Product 1 -->
        <div class="order-item">
          <img src="product-image-1.jpg" alt="Apple iPhone 14 Pro Max 128GB">
          <div class="item-details">
            <h3>Apple iPhone 14 Pro Max 128GB</h3>
            <p class="item-price">$1098</p>
          </div>
        </div>

        <!-- Product 2 -->
        <div class="order-item">
          <img src="product-image-2.jpg" alt="AirPods Max Silver">
          <div class="item-details">
            <h3>AirPods Max Silver</h3>
            <p class="item-price">$549</p>
          </div>
        </div>

        <!-- Product 3 -->
        <div class="order-item">
          <img src="product-image-3.jpg" alt="Apple Watch Series 6 GPS 44mm">
          <div class="item-details">
            <h3>Apple Watch Series 6 GPS 44mm</h3>
            <p class="item-price">$399</p>
          </div>
        </div>
      </div>

      <div class="order-info">
        <div class="info-section">
          <h4>Address</h4>
          <p>1131 Dusty Townline, Jacksonville, TX 40322</p>
        </div>
        <div class="info-section">
          <h4>Shipment method</h4>
          <p>Free</p>
        </div>
      </div>

      <div class="order-summary">
        <div class="summary-row">
          <span>Subtotal</span>
          <span>$2347</span>
        </div>
        <div class="summary-row">
          <span>Estimated Tax</span>
          <span>$50</span>
        </div>
        <div class="summary-row">
          <span>Estimated shipping & Handling</span>
          <span>$29</span>
        </div>
        <div class="summary-row total">
          <span>Total</span>
          <span>$2426</span>
        </div>
      </div>

      <div class="checkout-actions">
        <button class="btn-back">Back</button>
        <button class="btn-pay">Pay</button>
      </div>
    </div>

    <div class="checkout-right">
      <h2 class="section-title">Payment</h2>
      
      <div class="payment-tabs">
        <button class="payment-tab active">Credit Card</button>
        <button class="payment-tab">PayPal</button>
        <button class="payment-tab">PayPal Credit</button>
      </div>

      <div class="payment-form">
        <div class="card-display">
          <div class="card-visual">
            <div class="card-chip"></div>
            <div class="card-number">4321 5432 6789 9320</div>
          </div>
        </div>

        <div class="form-group">
          <label>Cardholder Name</label>
          <input type="text" placeholder="Enter cardholder name">
        </div>

        <div class="form-group">
          <label>Card Number</label>
          <input type="text" placeholder="Enter card number">
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Exp. Date</label>
            <input type="text" placeholder="MM/YY">
          </div>
          <div class="form-group">
            <label>CVV</label>
            <input type="text" placeholder="CVV">
          </div>
        </div>

        <div class="checkbox-group">
          <input type="checkbox" id="same-billing">
          <label for="same-billing">Same as billing address</label>
        </div>
      </div>
    </div>
  </div>

  <footer class="checkout-footer">
    <!-- Same footer as previous steps -->
  </footer>
</div>