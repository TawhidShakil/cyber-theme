{{ 'checkout-step1.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* Step 3 Grid Layout */
  .checkout-main-grid {
    display: grid;
    grid-template-columns: 400px 1fr;
    gap: 60px;
    align-items: start;
    margin-top: 40px;
  }

  /* Left Column: Summary Card */
  .summary-sidebar {
    border: 1px solid #eef0f2;
    border-radius: 16px;
    padding: 30px;
    background: #fff;
    position: sticky;
    top: 20px;
  }
  .summary-title { font-size: 22px; font-weight: 700; margin-bottom: 24px; }
  
  .cart-item-row { 
    display: flex; 
    align-items: center; 
    justify-content: space-between;
    background: #f9fafb;
    padding: 12px;
    border-radius: 12px;
    margin-bottom: 12px;
  }
  .item-meta { display: flex; align-items: center; gap: 12px; }
  .item-thumb { width: 45px; height: 45px; object-fit: contain; background: #fff; border-radius: 6px; }
  .item-name { font-size: 14px; font-weight: 500; color: #111; max-width: 180px; }
  .item-price { font-size: 14px; font-weight: 700; }

  .summary-info-block { margin: 20px 0; padding-top: 15px; border-top: 1px solid #f3f4f6; }
  .info-label { font-size: 12px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 5px; display: block; }
  .info-text { font-size: 14px; color: #1f2937; line-height: 1.4; }

  .price-breakdown { margin-top: 20px; }
  .price-row { display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 14px; color: #4b5563; }
  .price-row.total-bold { margin-top: 15px; color: #000; font-weight: 700; font-size: 18px; border-top: 1px solid #000; padding-top: 15px; }

  /* Right Column: Payment UI */
  .payment-heading { font-size: 24px; font-weight: 700; margin-bottom: 25px; }
  .payment-tabs { display: flex; gap: 30px; border-bottom: 1px solid #e5e7eb; margin-bottom: 30px; }
  .tab-btn { padding-bottom: 12px; font-size: 14px; color: #9ca3af; cursor: pointer; border-bottom: 2px solid transparent; background: none; border-top:none; border-left:none; border-right:none; }
  .tab-btn.active { color: #000; border-bottom-color: #000; font-weight: 600; }

  /* Visual Card */
  .card-visual {
    width: 100%; max-width: 380px; height: 220px;
    background: linear-gradient(135deg, #111827 0%, #374151 100%);
    border-radius: 15px; padding: 25px; color: #fff; position: relative; margin-bottom: 30px;
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }
  .card-chip { width: 40px; height: 30px; background: #fbbf24; border-radius: 6px; margin-bottom: 35px; }
  .card-num-display { font-size: 20px; letter-spacing: 2px; font-family: monospace; margin-bottom: 25px; }
  .card-name-display { font-size: 12px; text-transform: uppercase; opacity: 0.8; }
  .card-logo { position: absolute; bottom: 25px; right: 25px; width: 45px; }

  /* Forms */
  .payment-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
  .full-width { grid-column: span 2; }
  .payment-form-grid input { padding: 14px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 15px; width: 100%; }
  
  .cod-message { padding: 30px; background: #f8f9fa; border-radius: 12px; border: 1px dashed #d1d5db; text-align: center; }

  .hidden { display: none !important; }

  /* Notification Toast */
  #adminNotification {
    position: fixed; top: 20px; left: 50%; transform: translateX(-50%);
    background: #000; color: #fff; padding: 15px 30px; border-radius: 50px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.3); z-index: 9999; display: none;
  }

  @media (max-width: 900px) {
    .checkout-main-grid { grid-template-columns: 1fr; }
    .summary-sidebar { order: 2; }
    .payment-section { order: 1; }
  }
{%- endstyle -%}

<div id="adminNotification">Order Confirmed! Syncing to Admin...</div>

<div class="checkout-container">
  <div class="checkout-steps">
    <div class="step active"><div class="step-info"><span class="step-label">Step 1</span><span class="step-name">Address</span></div></div>
    <div class="step active"><div class="step-info"><span class="step-label">Step 2</span><span class="step-name">Shipping</span></div></div>
    <div class="step active"><div class="step-info"><span class="step-label">Step 3</span><span class="step-name">Payment</span></div></div>
  </div>

  <div class="checkout-main-grid">
    <aside class="summary-sidebar">
      <h3 class="summary-title">Summary</h3>
      <div class="cart-items">
        {% for item in cart.items %}
          <div class="cart-item-row">
            <div class="item-meta">
              <img src="{{ item.image | img_url: '100x' }}" class="item-thumb">
              <span class="item-name">{{ item.product.title }}</span>
            </div>
            <span class="item-price">{{ item.final_line_price | money_without_trailing_zeros }}</span>
          </div>
        {% endfor %}
      </div>

      <div class="summary-info-block">
        <span class="info-label">Address</span>
        <p class="info-text" id="sumAddress">Loading...</p>
      </div>

      <div class="summary-info-block">
        <span class="info-label">Shipment method</span>
        <p class="info-text" id="sumShip">Loading...</p>
      </div>

      <div class="price-breakdown">
        <div class="price-row"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div>
        <div class="price-row"><span>Estimated Tax</span><span>$50</span></div>
        <div class="price-row"><span>Shipping</span><span>$29</span></div>
        <div class="price-row total-bold"><span>Total</span><span>{{ cart.total_price | plus: 7900 | money }}</span></div>
      </div>
    </aside>

    <section class="payment-section">
      <h2 class="payment-heading">Payment</h2>
      
      <div class="payment-tabs">
        <button class="tab-btn active" onclick="setPayment('card', this)">Credit Card</button>
        <button class="tab-btn" onclick="setPayment('cod', this)">Cash on Delivery</button>
        <button class="tab-btn" disabled>PayPal</button>
      </div>

      <div id="cardSection">
        <div class="card-visual">
          <div class="card-chip"></div>
          <div class="card-num-display" id="cardNumPrev">4085  9536  8475  9530</div>
          <div class="card-name-display" id="cardNamePrev">Cardholder Name</div>
          <img src="https://upload.wikimedia.org/wikipedia/commons/2/2a/Mastercard-logo.svg" class="card-logo">
        </div>

        <form class="payment-form-grid" id="cardForm">
          <input type="text" class="full-width" id="inputName" placeholder="Cardholder Name" required>
          <input type="text" class="full-width" id="inputNum" placeholder="Card Number" maxlength="19" required>
          <input type="text" placeholder="Exp. Date (MM/YY)" maxlength="5" required>
          <input type="text" placeholder="CVV" maxlength="3" required>
        </form>
      </div>

      <div id="codSection" class="hidden">
        <div class="cod-message">
          <p><strong>You have selected Cash on Delivery.</strong></p>
          <p>You will pay the total amount to the courier when your package arrives.</p>
        </div>
      </div>

      <div style="margin-top: 20px; display: flex; align-items: center; gap: 10px;">
        <input type="checkbox" checked id="billingCheck">
        <label for="billingCheck" style="font-size: 14px;">Same as billing address</label>
      </div>

      <div class="checkout-footer" style="margin-top: 40px;">
        <button type="button" class="btn-back" onclick="history.back()">Back</button>
        <button type="button" class="btn-next" id="payBtn" onclick="confirmOrder()">Pay</button>
      </div>
    </section>
  </div>
</div>

<script>
  let paymentMethod = 'card';

  // Toggle Payment Methods
  function setPayment(type, el) {
    paymentMethod = type;
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    el.classList.add('active');

    if (type === 'cod') {
      document.getElementById('cardSection').classList.add('hidden');
      document.getElementById('codSection').classList.remove('hidden');
      document.getElementById('payBtn').innerText = "Confirm Order";
    } else {
      document.getElementById('cardSection').classList.remove('hidden');
      document.getElementById('codSection').classList.add('hidden');
      document.getElementById('payBtn').innerText = "Pay";
    }
  }

  // Real-time Card Update
  document.getElementById('inputName').addEventListener('input', (e) => {
    document.getElementById('cardNamePrev').innerText = e.target.value || "Cardholder Name";
  });

  document.getElementById('inputNum').addEventListener('input', (e) => {
    let val = e.target.value.replace(/\s+/g, '').replace(/[^0-9]/gi, '');
    let formatted = val.match(/.{1,4}/g)?.join('  ') || "";
    e.target.value = formatted;
    document.getElementById('cardNumPrev').innerText = formatted || "4085  9536  8475  9530";
  });

  // Final Confirmation & Admin Notification
  async function confirmOrder() {
    const btn = document.getElementById('payBtn');
    btn.disabled = true;
    btn.innerText = "Processing...";

    // Show Admin Notification
    const toast = document.getElementById('adminNotification');
    toast.style.display = 'block';

    // Collect Cart Data
    const cartItems = await fetch('/cart.js').then(r => r.json());
    
    // Simulate Admin Sync (Actual Order Creation happens via Shopify API)
    console.log("Creating Order for Admin:", {
      method: paymentMethod,
      items: cartItems.items,
      status: paymentMethod === 'cod' ? 'Payment Pending' : 'Paid'
    });

    // Clear cart and go to Thank You page
    setTimeout(() => {
      fetch('/cart/clear.js').then(() => {
        window.location.href = "/pages/thank-you";
      });
    }, 2500);
  }

  // Load Previous Session Info
  document.addEventListener('DOMContentLoaded', () => {
    const ship = JSON.parse(sessionStorage.getItem('selected_shipping') || '{}');
    document.getElementById('sumShip').innerText = ship.method ? ship.method.toUpperCase() : "Free";
    document.getElementById('sumAddress').innerText = "1131 Dusty Townline, Jacksonville, TX 40322"; 
  });
</script>