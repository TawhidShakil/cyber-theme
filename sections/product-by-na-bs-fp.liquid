<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  .font-inter {
    font-family: 'Inter'
    , sans-serif;
  }
  .tab-link.active {
    color: black !important;
    border-bottom: 2px solid black;
  }
  .tab-content {
    display: none;
  }
  .tab-content.active {
    display: grid;
  }
</style>

<section class="max-w-[1440px] mx-auto pt-20 pb-20 px-[160px]  font-inter bg-white">

  <div class="flex gap-8 border-b border-gray-100 mb-10">
    {% for i in (1..3) %}
      {% capture tab_title_key %}tab_{{ i }}_title{% endcapture %}
      {% capture collection_key %}collection_{{ i }}{% endcapture %}
      {% assign col = section.settings[collection_key] %}

      {% if col != blank %}
        <button onclick="openTab(event, 'tab-{{ i }}')" class="tab-link {% if i == 1 %}active{% endif %} pb-2 text-base font-medium text-gray-400 transition-all cursor-pointer">
          {{ section.settings[tab_title_key] | default: col.title }}
        </button>
      {% endif %}
    {% endfor %}
  </div>

  <div class="tabs-container">
    {% for i in (1..3) %}
      {% capture collection_key %}collection_{{ i }}{% endcapture %}
      {% assign col = section.settings[collection_key] %}

      <div id="tab-{{ i }}" class="tab-content {% if i == 1 %}active{% endif %} grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
        {% for product in col.products limit: 8 %}
          {% render 'product-card-item', card_product: product %}
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</section>

<script>
  function openTab(evt, tabId) {
    const tabContents = document.querySelectorAll(".tab-content");
    const tabLinks = document.querySelectorAll(".tab-link");

    tabContents.forEach(content => {
      content.style.display = "none";
      content.classList.remove("active");
    });

    tabLinks.forEach(link => {
      link.classList.remove("active");
    });

    const activeContent = document.getElementById(tabId);
    activeContent.style.display = "grid";
    activeContent.classList.add("active");
    evt.currentTarget.classList.add("active");
  }
</script>

<script>
  function toggleWishlist(button) {
    const icon = button.querySelector('svg');
    
  
    if (icon.classList.contains('fill-transparent')) {
  
      icon.classList.remove('fill-transparent', 'stroke-gray-400');
      icon.classList.add('fill-[#EB5757]', 'stroke-[#EB5757]');
    } else {
      
      icon.classList.remove('fill-[#EB5757]', 'stroke-[#EB5757]');
      icon.classList.add('fill-transparent', 'stroke-gray-400');
    }
  }
</script>

{% schema %}
  {
    "name": "Product Tabs",
    "settings": [
      {
        "type": "text",
        "id": "tab_1_title",
        "label": "Tab 1 Title",
        "default": "New Arrival"
      },
      {
        "type": "collection",
        "id": "collection_1",
        "label": "Tab 1 Collection"
      },
      {
        "type": "text",
        "id": "tab_2_title",
        "label": "Tab 2 Title",
        "default": "Bestseller"
      },
      {
        "type": "collection",
        "id": "collection_2",
        "label": "Tab 2 Collection"
      }, {
        "type": "text",
        "id": "tab_3_title",
        "label": "Tab 3 Title",
        "default": "Featured Products"
      }, {
        "type": "collection",
        "id": "collection_3",
        "label": "Tab 3 Collection"
      }
    ],
    "presets": [
      {
        "name": "Product Tabs",
        "category": "Products"
      }
    ]
  }
{% endschema %}