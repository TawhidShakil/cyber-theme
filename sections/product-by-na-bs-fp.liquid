<style>
  .font-inter {
    font-family: 'Inter', sans-serif;
  }
  
  .tab-link {
    position: relative;
    transition: all 0.3s ease;
  }
  
  .tab-link.active {
    color: #000 !important;
  }
  
  .tab-link.active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: #000;
    animation: slideIn 0.3s ease;
  }
  
  @keyframes slideIn {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  
  .tab-content {
    display: none;
    animation: fadeIn 0.4s ease;
  }
  
  .tab-content.active {
    display: grid;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

