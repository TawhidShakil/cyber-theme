<div class="section-container max-w-[1440px] mx-auto pt-20 pb-20 font-inter">

  {%- comment -%} Tab Navigation {%- endcomment -%}
  <div class="flex gap-8 border-b border-gray-200 mb-10 overflow-x-auto">
    {% for i in (1..3) %}
      {% capture tab_title_key %}tab_{{ i }}_title{% endcapture %}
      {% capture collection_key %}collection_{{ i }}{% endcapture %}
      {% assign col = section.settings[collection_key] %}

      {% if col != blank %}
        <button 
          onclick="openTab(event, 'tab-{{ i }}')" 
          class="tab-link {% if i == 1 %}active{% endif %} pb-3 text-base font-medium text-gray-400 hover:text-gray-600 transition-colors cursor-pointer whitespace-nowrap"
          aria-label="Switch to {{ section.settings[tab_title_key] | default: col.title }}"
        >
          {{ section.settings[tab_title_key] | default: col.title }}
        </button>
      {% endif %}
    {% endfor %}
  </div>

  {%- comment -%} Tab Content {%- endcomment -%}
  <div class="tabs-container">
    {% for i in (1..3) %}
      {% capture collection_key %}collection_{{ i }}{% endcapture %}
      {% assign col = section.settings[collection_key] %}

      {% if col != blank %}
        <div 
          id="tab-{{ i }}" 
          class="tab-content {% if i == 1 %}active{% endif %} grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-5 place-items-center gap-4"
        >
          {% for product in col.products limit: 10 %}
            {% render 'product-card-item', card_product: product %}
          {% else %}
            {%- comment -%} Empty state {%- endcomment -%}
            <div class="col-span-full text-center py-12">
              <p class="text-gray-500 text-lg">No products found in this collection.</p>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<script>
  function openTab(evt, tabId) {
    // Hide all tab contents
    const tabContents = document.querySelectorAll(".tab-content");
    const tabLinks = document.querySelectorAll(".tab-link");

    tabContents.forEach(content => {
      content.classList.remove("active");
    });

    // Remove active class from all tabs
    tabLinks.forEach(link => {
      link.classList.remove("active");
    });

    // Show selected tab and mark as active
    const activeContent = document.getElementById(tabId);
    if (activeContent) {
      activeContent.classList.add("active");
    }
    evt.currentTarget.classList.add("active");
  }

  function toggleWishlist(button) {
    const icon = button.querySelector('svg');
    
    if (icon.classList.contains('fill-transparent')) {
      // Add to wishlist
      icon.classList.remove('fill-transparent', 'stroke-gray-400');
      icon.classList.add('fill-[#EB5757]', 'stroke-[#EB5757]');
      
      // Optional: Add to wishlist via AJAX
      // addToWishlist(productId);
    } else {
      // Remove from wishlist
      icon.classList.remove('fill-[#EB5757]', 'stroke-[#EB5757]');
      icon.classList.add('fill-transparent', 'stroke-gray-400');
      
      // Optional: Remove from wishlist via AJAX
      // removeFromWishlist(productId);
    }
  }
</script>

{% schema %}
{
  "name": "Product Tabs",
  "settings": [
    {
      "type": "text",
      "id": "tab_1_title",
      "label": "Tab 1 Title",
      "default": "New Arrival"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Tab 1 Collection"
    },
    {
      "type": "text",
      "id": "tab_2_title",
      "label": "Tab 2 Title",
      "default": "Bestseller"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Tab 2 Collection"
    },
    {
      "type": "text",
      "id": "tab_3_title",
      "label": "Tab 3 Title",
      "default": "Featured Products"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Tab 3 Collection"
    }
  ],
  "presets": [
    {
      "name": "Product Tabs",
      "category": "Products"
    }
  ]
}
{% endschema %}
