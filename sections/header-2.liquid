<style>
  #res-control {
    display: none;
  }

  @media (min-width: 640px) {
    #res-control {
      display: flex;
    }
  }
</style>
<header class="bg-white border-b border-gray-100 shadow-sm sticky top-0 z-50 group">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 md:px-10 lg:px-20 xl:px-[160px] flex items-center justify-between py-4 gap:2">

    <!--  LOGO -->
    <div class="shrink-0">
      {% if section.settings.logo != blank %}
        <a href="{{ routes.root_url }}" class="block">
          {{ section.settings.logo | image_url: width: section.settings.logo_width | image_tag: class: 'h-8 w-auto', loading: 'eager' }}
        </a>
      {% elsif settings.logo != blank %}
        <a href="{{ routes.root_url }}" class="block">
          {{ settings.logo | image_url: width: section.settings.logo_width | default: 100 | image_tag: class: 'h-8 w-auto', loading: 'eager' }}
        </a>
      {% else %}
        <a href="{{ routes.root_url }}" class="flex items-center gap-2 text-xl font-bold tracking-tight text-gray-900">
          <svg class="w-8 h-8 text-black" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L2 19h20L12 2zm0 3.82l6.36 11.18H5.64L12 5.82z"/>
          </svg>
          <span>cyber</span>
        </a>
      {% endif %}
    </div>

    <!--  SEARCH BAR -->
    <div class="sm:w-[230px]
                md:w-[270px]
                lg:w-[310px]
                xl:w-[372px]" id="res-control">
      <form action="{{ routes.search_url }}" method="get" role="search" class="w-full">
        <div class="relative group">
          <span class="absolute inset-y-0 left-4 flex items-center text-gray-400 group-focus-within:text-gray-600">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </span>
          <input
            type="search"
            name="q"
            placeholder="Search"
            value="{{ search.terms | escape }}"
            class="w-full h-12 bg-gray-50 border-none rounded-lg placeholder-gray-400 pl-12 pr-4 focus:ring-1 focus:ring-gray-200 focus:bg-white text-sm"
          >
        </div>
      </form>
    </div>

    <!-- NAVIGATION MENU -->
    <nav class="font-var[(--font-body)]" id="res-control">
      <ul class="flex gap-4 lg:gap-8 text-[14px] font-medium text-gray-400">
        {% for link in section.settings.navigation.links %}
           {% unless link.title == 'Header' %}
            <li class="relative group">
                <a href="{{ link.url }}" class="font-medium hover:font-bold hover:text-[var(--color-charcoal)] transition-all whitespace-nowrap
">
                {{ link.title }}
                </a>
            </li>
          {% endunless %}
        {% endfor %}
      </ul>
    </nav>

    <!-- ICONS (Wishlist, Cart, Account) -->
    <div class="flex sm:gap-4 lg:gap-8" id="res-control">

      <!-- Wishlist -->
      <a href="#" class="text-gray-700 hover:text-black transition">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
        </svg>
      </a>

      <!-- Cart -->
      <a href="{{ routes.cart_url }}"
   class="relative"
   id="cart-icon-bubble">

  <!-- Cart Icon -->
  <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
  </svg>

  <!-- Dawn Compatible Bubble -->
  <span
  id="cart-count-badge"
  class="absolute -top-1 -right-1 bg-black text-white text-[11px]
         font-bold w-5 h-5 flex items-center justify-center rounded-full"
  {% if cart.item_count == 0 %}style="display:none"{% endif %}
>
  {{ cart.item_count }}
</span>

</a>


      <!-- Account -->
      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}" class="text-gray-700 hover:text-black transition">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
        </a>
      {% endif %}

    </div>

    <!-- drawer component Demo -->
      <div id="drawer-navigation" class="bg-white fixed top-24 left-0 z-40 h-screen p-4 overflow-y-auto transition-transform -translate-x-full bg-neutral-primary-soft w-80 border-e border-default" tabindex="-1" aria-labelledby="drawer-navigation-label">
        <div class="border-b border-default pb-4 flex items-center">
            
            <button id="menu-close" type="button"
              class="text-body bg-transparent hover:text-heading hover:bg-neutral-tertiary rounded-base w-9 h-9 absolute top-2.5  flex items-center justify-center">
              <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 17.94 6M18 18 6.06 6"/></svg>
              <span class="sr-only">Close menu</span>
            </button>
        </div>
        <div class="py-5 overflow-y-auto">
          
          {%  render 'search-drawer' %}
          {%  render 'button-icons' %} 
          <ul class="flex flex-col gap-4 font-base">
            {% for link in section.settings.navigation.links %}
              {% unless link.title == 'Header' %}
                <li>
                  <a
                    href="{{ link.url }}"
                    class="block text-[16px] font-medium text-gray-700 hover:text-[var(--color-charcoal)] transition-colors"
                  >
                    {{ link.title }}
                  </a>
                </li>
              {% endunless %}
            {% endfor %}
          </ul>

        </div>
        
      </div> 

    <!-- MOBILE MENU BUTTON -->
    <button class="sm:hidden" id="menu-open">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>

  </div>

  <!-- HOVER CATEGORY DRAWER -->
  <div class="absolute top-full left-0 w-full bg-[#2E2E2E] text-white opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-4 group-hover:translate-y-0 z-40 border-t border-gray-700 shadow-2xl">
    <div class="container mx-auto px-4 lg:px-8 py-0">
      <div class="flex flex-col lg:flex-row gap-8">
        
        <!-- Categories Flex -->
        <div class="flex-1 flex flex-nowrap items-center justify-center w-full">
           {% for block in section.blocks %}
             {% if block.type == 'category' %}
               <a href="{{ block.settings.link }}" class="flex items-center gap-3 px-6 py-2 border-r border-white/10 last:border-0 hover:opacity-100 opacity-70 transition group/item">
                 {% if block.settings.icon != blank %}
                   {{ block.settings.icon | image_url: width: 30 | image_tag: class: 'w-6 h-6 object-contain invert brightness-0 opacity-80 group-hover/item:opacity-100 transition' }}
                 {% else %}
                    <!-- Fallback Icon if none uploaded -->
                    <svg class="w-6 h-6 text-gray-400 group-hover/item:text-white transition" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
                 {% endif %}
                 <span class="text-base font-normal text-gray-300 group-hover/item:text-white capitalize tracking-wide transition whitespace-nowrap">{{ block.settings.title }}</span>
               </a>
             {% endif %}
           {% endfor %}
        </div>

      </div>
    </div>
  </div>

  <!-- Toast Popup -->
  <div
    id="cart-toast"
    class="fixed top-6 right-6 bg-black text-white px-5 py-3 rounded-xl shadow-lg text-[16px] font-medium opacity-0 pointer-events-none transition-all duration-300 z-[9999]"
  >
    Added to cart!
  </div>
<script>
      document.addEventListener('DOMContentLoaded', function () {
        const drawer = document.getElementById('drawer-navigation');
        const openBtn = document.getElementById('menu-open');
        const closeBtn = document.getElementById('menu-close');

        // OPEN drawer
        openBtn.addEventListener('click', function () {
          drawer.classList.remove('-translate-x-full');
          drawer.classList.add('translate-x-0');
          document.body.classList.add('overflow-hidden');
        });

        // CLOSE drawer
        closeBtn.addEventListener('click', function () {
          drawer.classList.remove('translate-x-0');
          drawer.classList.add('-translate-x-full');
          document.body.classList.remove('overflow-hidden');
        });

        // Close drawer when clicking outside (optional)
        document.addEventListener('click', function (e) {
          if (
            drawer.classList.contains('translate-x-0') &&
            !drawer.contains(e.target) &&
            !openBtn.contains(e.target)
          ) {
            drawer.classList.remove('translate-x-0');
            drawer.classList.add('-translate-x-full');
            document.body.classList.remove('overflow-hidden');
          }
        });
      });
    </script>
</header>
 
{% schema %}
  {
  "name": "Header",
  "settings": [
  {
    "type": "link_list",
    "id": "navigation",
    "label": "Main navigation menu"
  },
  {
    "type": "image_picker",
    "id": "logo",
    "label": "Logo"
  },
  {
    "type": "range",
    "id": "logo_width",
    "min": 50,
    "max": 250,
    "step": 10,
    "default": 120,
    "unit": "px",
    "label": "Logo width"
  }
  ],
  "blocks": [
  {
    "type": "category",
    "name": "Category Item",
    "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Category Name",
      "default": "Phones"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Category Icon"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Category Link"
    }
    ]
  }
  ],
  "max_blocks": 6,
  "presets": [
  {
    "name": "Header Category Icons"
  }
  ]
  }
{% endschema %}