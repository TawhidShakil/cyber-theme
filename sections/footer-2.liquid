<footer style="background-color: {{ section.settings.color_background }}; color: {{ section.settings.color_text }};" class="flex flex-col p-32 text-center md:text-left">

  <div class="flex flex-col md:flex-row md:text-left">
    
    <!-- LEFT SIDE -->
    <div class="w-full md:w-[45%] flex flex-col items-center md:items-start gap-8">
      
      <div class="flex justify-center md:justify-start">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: section.settings.logo_width | image_tag: class: "h-8 w-auto", loading: "eager" }}
        {% endif %}
      </div>

      <div class="text-base mt-4 max-w-md">
        {{ section.settings.description }}
      </div>

    </div>
    
    <!-- RIGHT SIDE (MENUS) -->
<div class="bg-black text-white w-full md:w-[55%] mt-8 md:mt-0">
  
  <div class="flex flex-col md:flex-row md:justify-between gap-8">

    {% for block in section.blocks %}
      {% if block.type == 'menu' and block.settings.navigation != blank %}

        <!-- MENU COLUMN -->
        <div class="flex-1 min-w-[150px] space-y-4">

          {% if block.settings.navigation.title != blank %}
            <h2 class="font-semibold text-sm uppercase tracking-wide" style="color: {{ section.settings.color_text }};">
              {{ block.settings.navigation.title }}
            </h2>
          {% endif %}

          {% if block.settings.navigation.links.size > 0 %}
            <ul class="space-y-2">
              {% for link in block.settings.navigation.links %}
                <li>
                  <a href="{{ link.url }}"
                     class="text-xl text-white/70 hover:text-white transition">
                    {{ link.title }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}

        </div>

      {% endif %}
    {% endfor %}

  </div>
</div>

  </div>

  <!-- SOCIAL ICONS -->
  {% if section.settings.show_social %}
    {% if settings.social_facebook_link != blank
       or settings.social_instagram_link != blank
       or settings.social_twitter_link != blank
       or settings.social_youtube_link != blank
       or settings.social_tiktok_link != blank
       or settings.social_pinterest_link != blank %}

      <div class="footer-social flex justify-center md:justify-start gap-4 mt-10">
        
        {% if settings.social_facebook_link != blank %}
          <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook" style="color: {{ section.settings.color_text }};">
            <!-- SVG -->
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7h-2.4v-2.9h2.4V9.8c0-2.4 1.4-3.8 3.6-3.8 1 0 2 .2 2 .2v2.2h-1.2c-1.2 0-1.6.8-1.6 1.6v2h2.8l-.5 2.9h-2.3v7A10 10 0 0 0 22 12z"/></svg>
          </a>
        {% endif %}

        {% if settings.social_instagram_link != blank %}
          <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram" style="color: {{ section.settings.color_text }};">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M7 2C4.2 2 2 4.2 2 7v10c0 2.8 2.2 5 5 5h10c2.8 0 5-2.2 5-5V7c0-2.8-2.2-5-5-5H7zm5 15.5A5.5 5.5 0 1 1 12 6a5.5 5.5 0 0 1 0 11.5zm6-11.8a1.3 1.3 0 1 1-2.6 0 1.3 1.3 0 0 1 2.6 0z"/></svg>
          </a>
        {% endif %}

        {% if settings.social_twitter_link != blank %}
          <a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener" aria-label="Twitter" style="color: {{ section.settings.color_text }};">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22 5.8c-.8.4-1.6.6-2.5.8a4.3 4.3 0 0 0 1.9-2.4 8.5 8.5 0 0 1-2.7 1A4.2 4.2 0 0 0 12 8.5c0 .3 0 .6.1.9-3.5-.2-6.6-1.9-8.7-4.6a4.3 4.3 0 0 0-.6 2.1 4.2 4.2 0 0 0 1.9 3.5c-.7 0-1.3-.2-1.9-.5v.1c0 2 1.4 3.7 3.3 4.1-.4.1-.8.2-1.2.2-.3 0-.6 0-.9-.1.6 1.8 2.3 3.1 4.3 3.1A8.5 8.5 0 0 1 2 19.5 12 12 0 0 0 8.5 21c7.8 0 12.1-6.6 12.1-12.3v-.6c.8-.6 1.5-1.3 2-2.1z"/></svg>
          </a>
        {% endif %}

        {% if settings.social_youtube_link != blank %}
          <a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener" aria-label="YouTube" style="color: {{ section.settings.color_text }};">
            <svg width="22" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2s-.2-1.7-.9-2.5c-.9-1-1.9-1-2.4-1.1C16.7 2.2 12 2.2 12 2.2h0s-4.7 0-8.2.4c-.5.1-1.5.1-2.4 1.1-.7.8-.9 2.5-.9 2.5S0 8.2 0 10.2v1.6c0 2 .5 4 .5 4s.2 1.7.9 2.5c.9 1 2.1 1 2.6 1.1 1.9.2 8 .4 8 .4s4.7 0 8.2-.4c.5-.1 1.5-.1 2.4-1.1.7-.8.9-2.5.9-2.5s.5-2 .5-4v-1.6c0-2-.5-4-.5-4zM9.7 14.7V7.9l6.2 3.4-6.2 3.4z"/></svg>
          </a>
        {% endif %}

        {% if settings.social_tiktok_link != blank %}
          <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" aria-label="TikTok" style="color: {{ section.settings.color_text }};">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg>
          </a>
        {% endif %}

        {% if settings.social_pinterest_link != blank %}
          <a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener" aria-label="Pinterest" style="color: {{ section.settings.color_text }};">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.26 2.67 7.9 6.43 9.34-.09-.79-.17-2.01.04-2.87.18-.78 1.18-5.01 1.18-5.01s-.3-.61-.3-1.5c0-1.41.82-2.46 1.84-2.46.87 0 1.29.65 1.29 1.43 0 .87-.55 2.17-.84 3.38-.24 1.01.51 1.84 1.51 1.84 1.81 0 3.21-1.91 3.21-4.66 0-2.44-1.75-4.14-4.26-4.14-2.9 0-4.6 2.17-4.6 4.42 0 .88.34 1.82.76 2.33.08.1.09.19.07.29-.08.31-.25 1.02-.28 1.16-.04.19-.14.23-.33.14-1.27-.59-2.06-2.45-2.06-3.94 0-3.21 2.33-6.16 6.72-6.16 3.53 0 6.27 2.52 6.27 5.87 0 3.5-2.21 6.32-5.27 6.32-1.03 0-2-.53-2.33-1.16 0 0-.51 1.94-.63 2.42-.23.88-.85 1.98-1.27 2.65.96.3 1.97.46 3.02.46 5.52 0 10-4.48 10-10S17.52 2 12 2z"/></svg>
          </a>
        {% endif %}

      </div>
    {% endif %}
  {% endif %}

</footer>



{% schema %}
{
  "name": "Footer 2",
  "tag": "section",
  "class": "section-footer-2",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 100,
      "unit": "px",
      "label": "Logo Width"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "Show Social Icons"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Footer Menu",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Menu Title",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "navigation",
          "label": "Navigation menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer 2"
    }
  ]
}
{% endschema %}